# =============================================================
#  ClientFlow — Environment Variables
#  Copy this file to the project root as ".env" and fill in
#  every value before running the application.
# =============================================================

# ── Database (Supabase PostgreSQL) ───────────────────────────
# Settings → Database → Connection String → URI
DATABASE_URL=postgresql://postgres:<YOUR_DB_PASSWORD>@db.<YOUR_PROJECT_REF>.supabase.co:5432/postgres?connect_timeout=10&pool_timeout=10

# ── NextAuth / Auth.js ───────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=<GENERATE_A_RANDOM_32_BYTE_SECRET>
# Change to your production domain when deploying
NEXTAUTH_URL=http://localhost:3000

# ── Supabase (Storage + API) ─────────────────────────────────
# Settings → API → Project URL & keys
NEXT_PUBLIC_SUPABASE_URL=https://<YOUR_PROJECT_REF>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<YOUR_SUPABASE_ANON_KEY>
SUPABASE_SERVICE_ROLE_KEY=<YOUR_SUPABASE_SERVICE_ROLE_KEY>

# ── Stripe (Payments) ────────────────────────────────────────
# Dashboard → Developers → API Keys
STRIPE_SECRET_KEY=sk_test_<YOUR_STRIPE_SECRET_KEY>
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_<YOUR_STRIPE_PUBLISHABLE_KEY>
# Dashboard → Developers → Webhooks → signing secret
STRIPE_WEBHOOK_SECRET=whsec_<YOUR_WEBHOOK_SECRET>

# ── Pusher (Real-time chat) ──────────────────────────────────
# pusher.com → App → Keys
PUSHER_APP_ID=<YOUR_PUSHER_APP_ID>
PUSHER_KEY=<YOUR_PUSHER_KEY>
PUSHER_SECRET=<YOUR_PUSHER_SECRET>
PUSHER_CLUSTER=<YOUR_PUSHER_CLUSTER>   # e.g. us2, eu, ap2

# ── Resend (Transactional email) ─────────────────────────────
# resend.com → API Keys
RESEND_API_KEY=re_<YOUR_RESEND_API_KEY>

# ── Upstash Redis (Rate limiting) ────────────────────────────
# console.upstash.com → Database → REST API
UPSTASH_REDIS_REST_URL=https://<YOUR_UPSTASH_URL>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<YOUR_UPSTASH_TOKEN>
